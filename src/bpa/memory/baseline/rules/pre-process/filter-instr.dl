// .input if_vex_exp



// control flow related
.decl edge(from_addr: Addr, to_addr: Addr)
.input edge

.decl inter_succ(from_addr: Addr, to_addr: Addr)
.input inter_succ

.decl jumps(addr: Addr, jumpkind: symbol, dest_type: symbol, dest_val: unsigned)
.input jumps


// only keep the facts related to user-defined functions

.decl set_tmp_reg_vex_new(addr: Addr, order: Order, size: Width, eid: Exp, tmp_reg: TmpReg)
.output set_tmp_reg_vex_new(filename="set_tmp_reg_vex.facts")
set_tmp_reg_vex_new(addr, order, size, eid, tmp_reg) :-
    set_tmp_reg_vex(addr, order, size, eid, tmp_reg),
    user_defined_addr_func(_, addr_lower, addr_upper),
    addr >= addr_lower,
    addr < addr_upper.

.decl set_loc_vex_new(addr: Addr, order: Order, size: Width, eid: Exp, loc: Loc)
.output set_loc_vex_new(filename="set_loc_vex.facts")
set_loc_vex_new(addr, order, size, eid, loc) :-
    set_loc_vex(addr, order, size, eid, loc),
    user_defined_addr_func(_, addr_lower, addr_upper),
    addr >= addr_lower,
    addr < addr_upper.

.decl set_mem_vex_new(addr: Addr, order: Order, size: Width, val_eid: Exp, addr_eid: Exp)
.output set_mem_vex_new(filename="set_mem_vex.facts")
set_mem_vex_new(addr, order, size, val_eid, addr_eid) :-
    set_mem_vex(addr, order, size, val_eid, addr_eid),
    user_defined_addr_func(_, addr_lower, addr_upper),
    addr >= addr_lower,
    addr < addr_upper.


.decl edge_new(from_addr: Addr, to_addr: Addr)
.output edge_new(filename="edge.facts")
edge_new(from_addr, to_addr) :-
    edge(from_addr, to_addr),
    user_defined_addr_func(_, from_addr_lower, from_addr_upper),
    from_addr >= from_addr_lower,
    from_addr < from_addr_upper,
    user_defined_addr_func(_, to_addr_lower, to_addr_upper),
    to_addr >= to_addr_lower,
    to_addr < to_addr_upper.

.decl inter_succ_new(from_addr: Addr, to_addr: Addr)
.output inter_succ_new(filename="inter_succ.facts")
inter_succ_new(from_addr, to_addr) :-
    inter_succ(from_addr, to_addr),
    user_defined_addr_func(_, addr_lower, addr_upper),
    from_addr >= addr_lower,
    from_addr < addr_upper,
    to_addr >= addr_lower,
    to_addr < addr_upper.

















